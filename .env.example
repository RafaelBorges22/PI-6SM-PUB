# Smart Parking - variaveis do docker compose.
# Copie para ".env" (na raiz do projeto) e altere so o que precisar:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)
# O .env esta no .gitignore. Sem ele, os valores abaixo ja sao os padroes.

# Porta do frontend Web no PC: http://localhost:WEB_PORT
WEB_PORT=8080

# Porta da API no PC. Se mudar, ajuste o campo "Endereco da API" na tela de login.
API_PORT=8085

# Porta do PostgreSQL no PC (troque para 5433 se ja houver um Postgres instalado).
POSTGRES_PORT=5432

# Porta MQTT no PC. Precisa ser igual ao MQTT_PORT do config.h do ESP32.
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Topico assinado pelo backend (o MQTT_TOPIC do ESP32 precisa casar com ele).
MQTT_TOPICO=smart-parking/vaga/+

# Segundos sem mensagem ate o dispositivo ficar OFFLINE.
TEMPO_LIMITE_OFFLINE=90

# Chave do JWT (minimo 32 caracteres).
JWT_SECRET=smart-parking-chave-de-desenvolvimento-nao-use-em-producao
